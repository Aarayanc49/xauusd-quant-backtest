# ── market data & caches ─────────────────────────────────────────────
# The bar store is ~5.4 GB of mmap'd numpy columns and is rebuilt from the
# broker with `python -m research.fetch mt5`. Study caches (_universe.json,
# _anchored.json, _book_*.json, _feat*.json) are regenerated by their own
# modules and reach several GB each.
data/

# ── python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── virtualenvs ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── tooling ──────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── editors / OS ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# ── secrets & runtime output ─────────────────────────────────────────
# live_journal.jsonl records the broker login and account balance.
*.log
*_journal.jsonl
.env
credentials.json

# ── packaged executable ──────────────────────────────────────────────
# `python build_cockpit.py` regenerates dist/Cockpit.exe (~20 MB) from
# source. Binaries do not belong in the repo.
build/
dist/
*.spec
